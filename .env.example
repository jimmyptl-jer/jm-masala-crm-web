# Copy to .env. These are PUBLIC values (they end up in the browser bundle).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where the API lives, including the /api/v1 prefix
VITE_API_URL=http://localhost:3000/api/v1
# Sign-in is done by Supabase Auth; the API checks the Supabase token. This must be the same project as SUPABASE_URL in api/.env.
# Leave VITE_API_URL empty (or unset) to run on built-in sample data in dev. A PRODUCTION build (npm run build) fails without it.
# To build the sample-data demo on purpose, set VITE_DEMO=true. Never use the demo build for real records.
# VITE_DEMO=true
# VITE_AUTH_BYPASS=true   # sample-data mode only: skips login

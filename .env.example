# Copy to .env. These are PUBLIC values (they end up in the browser bundle).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where the API lives, including the /api/v1 prefix
VITE_API_URL=http://localhost:3000/api/v1

# Use the API's fixed-user login (needs SIMPLE_AUTH=true on the API)
VITE_SIMPLE_AUTH=true
